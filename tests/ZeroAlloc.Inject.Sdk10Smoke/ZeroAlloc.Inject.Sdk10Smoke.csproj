<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Builds a consumer of the packed ZeroAlloc.Inject and ZeroAlloc.Inject.Generator packages
    with the oldest supported .NET SDK band, 10.0.1xx, whose compiler is Roslyn 5.0. A
    generator built against a newer Roslyn than the compiler that loads it is skipped with
    CS9057, and the generated AddZeroAllocInjectSdk10SmokeServices method then does not exist.
    That warning is an error here, so the build fails instead of passing without the generator.

    global.json pins the 10.0.1xx band with rollForward latestPatch, so a newer band cannot
    stand in for it. Run locally with a 10.0.1xx SDK installed:
      dotnet pack ZeroAlloc.Inject.slnx -c Release -o artifacts -p:Version=9.9.9-local.<sha>
      cd tests/ZeroAlloc.Inject.Sdk10Smoke
      dotnet run -c Release -p:ZeroAllocInjectVersion=9.9.9-local.<sha>
    Not part of ZeroAlloc.Inject.slnx; the sdk10-consumer job in ci.yml runs it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <WarningsAsErrors>$(WarningsAsErrors);CS9057;CS8032</WarningsAsErrors>
  </PropertyGroup>

  <Target Name="RequireZeroAllocInjectVersion" BeforeTargets="CollectPackageReferences">
    <Error Condition="'$(ZeroAllocInjectVersion)' == ''"
           Text="Pass the version of the packed packages: -p:ZeroAllocInjectVersion=..." />
  </Target>

  <ItemGroup>
    <PackageReference Include="ZeroAlloc.Inject" Version="[$(ZeroAllocInjectVersion)]" />
    <PackageReference Include="ZeroAlloc.Inject.Generator" Version="[$(ZeroAllocInjectVersion)]"
                      PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>
</Project>
