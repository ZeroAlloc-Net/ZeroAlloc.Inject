<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Builds a consumer of the packed ZeroAlloc.Inject.Container package alone, the way hybrid and
    ASP.NET Core users install it, with the oldest supported .NET SDK band, 10.0.1xx. That package
    does not depend on ZeroAlloc.Inject.Generator: it bundles its own copy of the generator in
    analyzers/dotnet/cs through the IncludeGeneratorInPackage target. This project proves that
    copy loads under Roslyn 5.0. If the compiler skips it, the generated
    AddZeroAllocInjectSdk10SmokeContainerServices and BuildZeroAllocInjectServiceProvider methods
    do not exist and the build fails with CS1061.

    CS9057 is an error here as in the Generator project. ZeroAlloc.Collections 1.3.2, a dependency
    of the package, also ships a generator built against Roslyn 5.0, so no package in this build
    may be skipped.

    Run locally with a 10.0.1xx SDK installed, in the shell that ran the Generator project's steps, so $v
    is set and the shell is in tests/ZeroAlloc.Inject.Sdk10Smoke/Generator:
      cd ../Container
      dotnet run -c Release -p:ZeroAllocInjectVersion=$v
    Not part of ZeroAlloc.Inject.slnx; the sdk10-consumer job in ci.yml runs it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <WarningsAsErrors>$(WarningsAsErrors);CS8032;CS9057</WarningsAsErrors>
  </PropertyGroup>

  <Target Name="RequireZeroAllocInjectVersion" BeforeTargets="CollectPackageReferences">
    <Error Condition="'$(ZeroAllocInjectVersion)' == ''"
           Text="Pass the version of the packed packages: -p:ZeroAllocInjectVersion=..." />
  </Target>

  <ItemGroup>
    <PackageReference Include="ZeroAlloc.Inject.Container" Version="[$(ZeroAllocInjectVersion)]" />
  </ItemGroup>
</Project>
